{
  "name": "sumit-mcp",
  "version": "1.0.0",
  "description": "MCP server for SUMIT (formerly OfficeGuy) Israeli billing \u2014 read invoices/debt, issue documents, and charge with layered safety. For Claude Code & OpenClaw.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sumit-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    ".claude/skills/sumit-mcp",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm bundle",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "sumit-api": "^0.5.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "0.28.1",
    "typescript": "^5.6.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}